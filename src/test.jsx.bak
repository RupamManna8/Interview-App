        python: `import math\ndef gcd(a, b):\n    while b:\n        a, b = b, a % b\n    return a\n\nprint(gcd(12, 18)) # 6\nprint(gcd(48, 18)) # 6`,
        java: `public class Main {\n    public static int gcd(int a, int b) {\n        while (b != 0) { int t = b; b = a % b; a = t; }\n        return a;\n    }\n}`,
        cpp: `#include <bits/stdc++.h>\nusing namespace std;\nint gcd(int a, int b) {\n    return b == 0 ? a : gcd(b, a % b);\n}`
