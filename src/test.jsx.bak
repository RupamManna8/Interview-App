      defaultCode: {
        javascript: `function mostFrequent(s) {\n  const freq = {};\n  for (const c of s) freq[c] = (freq[c] || 0) + 1;\n  return Object.entries(freq).reduce((a, b) => b[1] > a[1] ? b : a)[0];\n}\n\nconsole.log(mostFrequent('infosys'));     // s\nconsole.log(mostFrequent('mississippi')); // i`,
        python: `from collections import Counter\ndef most_frequent(s):\n    return Counter(s).most_common(1)[0][0]\n\nprint(most_frequent('infosys'))     # s\nprint(most_frequent('mississippi')) # i`,
        java: `import java.util.*;\npublic class Main {\n    public static char mostFrequent(String s) {\n        Map<Character, Integer> m = new HashMap<>();\n        for (char c : s.toCharArray()) m.merge(c, 1, Integer::sum);\n        return Collections.max(m.entrySet(), Map.Entry.comparingByValue()).getKey();\n    }\n}`,
        cpp: `#include <bits/stdc++.h>\nusing namespace std;\nchar mostFrequent(string s) {\n    map<char,int> freq;\n    for (char c : s) freq[c]++;\n    return max_element(freq.begin(), freq.end(),\n        [](auto& a, auto& b){ return a.second < b.second; })->first;\n}`
