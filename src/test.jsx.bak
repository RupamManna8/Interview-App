const QUESTIONS = {
  easy: [
    {
      id: "e1", category: "Number Theory", difficulty: "Easy",
      title: "Automorphic Number",
      description: "Check if a given number is an Automorphic number. A number is called automorphic if its square ends with the same digits as the number itself.",
      hints: ["Calculate the square of the number first.", "Use the modulo operator (%) with a power of 10 equal to the number of digits."],
      testcases: [
        { input: "5", output: "true (5²=25)" },
        { input: "25", output: "true (25²=625)" },
        { input: "76", output: "true (76²=5776)" },
        { input: "10", output: "false" },
        { input: "376", output: "true (376²=141376)" },
      ],
      defaultCode: {
        javascript: `function isAutomorphic(n) {\n  const sq = n * n;\n  const digits = String(n).length;\n  return sq % (10 ** digits) === n;\n}\n\nconsole.log(isAutomorphic(5));   // true\nconsole.log(isAutomorphic(25));  // true\nconsole.log(isAutomorphic(76));  // true\nconsole.log(isAutomorphic(10));  // false`,
        python: `def is_automorphic(n):\n    sq = n * n\n    digits = len(str(n))\n    return sq % (10 ** digits) == n\n\nprint(is_automorphic(5))   # True\nprint(is_automorphic(25))  # True\nprint(is_automorphic(76))  # True\nprint(is_automorphic(10))  # False`,
        java: `public class Main {\n    public static boolean isAutomorphic(int n) {\n        long sq = (long) n * n;\n        int digits = String.valueOf(n).length();\n        return sq % (long) Math.pow(10, digits) == n;\n    }\n    public static void main(String[] args) {\n        System.out.println(isAutomorphic(5));  // true\n        System.out.println(isAutomorphic(76)); // true\n    }\n}`,
        cpp: `#include <bits/stdc++.h>\nusing namespace std;\nbool isAutomorphic(int n) {\n    long long sq = (long long)n * n;\n    int d = to_string(n).length();\n    return sq % (long long)pow(10, d) == n;\n}\nint main() {\n    cout << isAutomorphic(5) << endl;  // 1\n    cout << isAutomorphic(10) << endl; // 0\n}`
      }
    },
    {
